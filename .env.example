# VAPID subject — must be a mailto: or https: URI that identifies you
VAPID_SUBJECT=mailto:you@example.com

# VAPID key pair — generate with: pnpm run generate:vapid
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# API key — protects /send and /send-many endpoints (Bearer token)
API_KEY=your_api_key_here

# Port the server listens on (default: 5500)
PORT=5500
